<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <meta name="description" content="Nook — A simple, collaborative space to bring ideas together." />
    <meta name="theme-color" content="#210A3B" />
    <title>{assigns[:page_title] || "Nook — Bring ideas together"}</title>
    <link phx-track-static rel="stylesheet" href="/assets/tailwind.css" />
    <link phx-track-static rel="stylesheet" href="/assets/app.css" />
    <link phx-track-static rel="stylesheet" href="/assets/toolbox.css" />
    <link phx-track-static rel="stylesheet" href="/assets/accounts.css?v=0.11.0" />
    <link phx-track-static rel="stylesheet" href="/assets/polish.css" />
    <link phx-track-static rel="stylesheet" href="/assets/usability.css" />
    <link phx-track-static rel="stylesheet" href="/assets/usability-2.css" />
    <link phx-track-static rel="stylesheet" href="/assets/visual-tools.css" />
    <link phx-track-static rel="stylesheet" href="/assets/workspace-layout.css?v=0.10.1" />
    <script phx-track-static type="module" src="/assets/live.mjs?v=0.11.0"></script>
  </head>
  <body class="antialiased selection:bg-purple-100"><a class="skip-link" href="#main-content">Skip to content</a><div id="main-content" tabindex="-1">{@inner_content}</div><noscript><p>Nook needs JavaScript for the collaborative canvas. Enable JavaScript and reload to continue.</p></noscript></body>
</html>
