# Reference only. Copy to a private environment manager; never commit real secrets.
# Prepared for later use. No hosting is enabled by this file.
PHX_SERVER=false
NOOK_BIND_IP=127.0.0.1
NOOK_HOST=nook.example.test
PORT=4000
SECRET_KEY_BASE=replace-with-a-new-random-secret-at-least-64-bytes
DATABASE_URL=ecto://user:password@database-host/nook_prod
DATABASE_SSL=true
POOL_SIZE=2
DB_IDLE_INTERVAL=600000
NOOK_EXPIRY_INTERVAL_MS=3600000
NOOK_AUTH_MODE=google
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://nook.example.test/auth/google/callback
# SMTP below is only required for NOOK_AUTH_MODE=email.
MAIL_FROM=nook@example.test
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
